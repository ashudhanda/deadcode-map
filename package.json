    "static-analysis",
    "tree-sitter",
    "refactoring",
    "code-quality"
  ],
  "license": "MIT",
  "main": "src/index.js",
  "name": "deadcode-map",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashudhanda/deadcode-map"
  },
  "scripts": {
    "start": "node bin/deadcode-map.js",
    "test": "node --test test/fixtures.test.js test/cli.test.js"
  },
  "type": "commonjs",
  "version": "0.1.0"
}
