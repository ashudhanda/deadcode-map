{
  "author": "deadcode-map contributors",
  "bin": {
    "deadcode-map": "./bin/deadcode-map.js"
  },
  "dependencies": {
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-typescript": "0.23.2"
  },
  "description": "Find dead code, prove it is dead, and see it on a map. JS/TS + Python. Confidence-graded, with --fix and --prove.",
  "engines": {
